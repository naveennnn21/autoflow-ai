# AutoFlow AI - environment template
# Copy to backend/.env (or the repo root .env) and fill in real values.
# NEVER commit real secrets.

# --- Backend ---
# PostgreSQL connection (async driver)
DATABASE_URL=postgresql+asyncpg://autoflow:autoflow_secret_dev@localhost:5432/autoflow
# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Secret used to sign JWTs - use a long random string in production:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-change-in-production-abc123xyz
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG
APP_NAME=AutoFlow AI

# Comma-separated origins allowed for CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Optional integrations
SENTRY_DSN=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_DEFAULT_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Frontend (frontend/.env.local) ---
# Set NEXT_PUBLIC_MOCK=false to talk to the real backend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MOCK=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
