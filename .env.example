# AutoFlow AI - environment template
# Copy to backend/.env and fill in real values.
# NEVER commit real secrets.  Only placeholders live in this file.
#
# For production generate a real secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- Backend -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://autoflow:CHANGE_ME@localhost:5432/autoflow
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set to "production" for deployment (disables debug headers, enables HSTS, etc.)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=AutoFlow AI

# Comma-separated origins allowed for CORS (no trailing slash)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Monitoring (optional) ---------------------------------------------
SENTRY_DSN=

# --- AI providers (fill with real keys) --------------------------------
# The planner picks the first configured provider in this preference order:
#   OpenAI > Anthropic > Gemini > OpenRouter
# With no key the planner runs its deterministic pipeline and reports
# mode=deterministic — it never pretends an LLM generated the plan.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Provider tuning (optional)
AI_DEFAULT_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# --- Payments (optional) -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Backups / off-host storage (optional) -----------------------------
# Off-host backups require an S3-compatible destination. Leave
# BACKUP_REMOTE_ENABLED=false to keep backups local-only (NOT disaster
# recovery - see docs/BACKUP_OPERATIONS.md).
BACKUP_REMOTE_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups
# Custom endpoint for S3-compatible storage (MinIO, R2, B2, ...). Leave empty
# for AWS S3.
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
# auto (path-style when a custom endpoint is set) | true | false
BACKUP_S3_FORCE_PATH_STYLE=auto
BACKUP_REMOTE_ALLOW_OVERWRITE=false
# Credentials for the object store. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# --- Backup failure alerting (optional) --------------------------------
BACKUP_ALERT_ENABLED=false
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_TIMEOUT_SECONDS=10

# --- Backup scheduling / retry (optional) ------------------------------
BACKUP_SCHEDULE_INTERVAL_SECONDS=86400
BACKUP_SCHEDULE_JITTER_SECONDS=0
BACKUP_SCHEDULE_RUN_ON_START=true
BACKUP_RETRY_ATTEMPTS=3
BACKUP_RETRY_DELAY_SECONDS=30
BACKUP_RETRY_MAX_DELAY_SECONDS=300
# Directory on the Docker host that holds local backups.
BACKUP_HOST_DIR=./infra/backups

# --- Frontend (frontend/.env.local) ------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MOCK=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000
