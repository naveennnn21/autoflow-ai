# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.env
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.db

# Node
node_modules/
.next/
out/
dist/
.npm/
.eslintcache
*.tsbuildinfo

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Docker
.docker/
*.log

# Secrets / local TLS material
**/secrets/
**/*.key
**/*.cert
*.pem
*.crt
*.p12
*.pfx

# Environment files. Only *.example templates are tracked; a real .env (or
# .env.staging / .env.local / .env.production) must never be committed.
# The negations keep .env.example and .env.staging.example tracked.
.env
.env.*
!.env.example
!*.example

# Backups (database dumps must never be committed)
infra/backups/
*.dump
*.sql
*.sql.gz
*.partial_*.sql
*.partial_*.err

# Agent / tooling metadata
.freebuff/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
crash.log

# K8s
**/kubeconfig
