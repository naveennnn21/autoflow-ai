# AutoFlow AI - backend environment configuration (example)
#
# Copy to `backend/.env` and fill in real values. NEVER commit the real
# `.env` or real API keys. Only placeholders live in this file.
#
# The AI Planner resolves the default LLM provider from the FIRST key
# present in this list (preference order: openai, anthropic, gemini,
# openrouter). With no key configured the planner runs its deterministic
# pipeline and reports mode=deterministic - it never pretends an LLM
# generated the plan.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://autoflow:CHANGE_ME@localhost:5432/autoflow
REDIS_URL=redis://localhost:6379/0

# --- Auth ---------------------------------------------------------------
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Runtime ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- CORS (comma-separated origins, no trailing slash) -----------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- LLM providers (placeholders - fill with real keys) ----------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Optional provider tuning -------------------------------------------
AI_DEFAULT_MODEL=gpt-4o
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2

# --- Monitoring (optional) ---------------------------------------------
SENTRY_DSN=

# --- Payments (optional) -----------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
