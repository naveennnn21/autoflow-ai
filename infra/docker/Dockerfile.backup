# AutoFlow AI - dedicated backup / off-host upload image
#
# Base image is postgres:16-alpine so the bundled pg_dump matches the server
# major version exactly (pg_dump refuses to dump a newer server). The image
# already provides bash, flock and the PostgreSQL 16 client tools; we add
# Python + boto3 for S3-compatible upload/verification and webhook alerting.
FROM postgres:16-alpine

COPY infra/docker/requirements-backup.txt /tmp/requirements-backup.txt
RUN apk add --no-cache python3 py3-pip \
 && pip install --no-cache-dir --break-system-packages -r /tmp/requirements-backup.txt \
 && rm -rf /root/.cache /tmp/*

WORKDIR /app

COPY infra/docker/backup.sh infra/docker/backup_ops.py infra/docker/backup_scheduler.sh /app/
RUN chmod +x /app/backup.sh /app/backup_scheduler.sh

# Long-running scheduler that invokes backup.sh (the Step 1 tested path).
# Overriding ENTRYPOINT avoids the base image's postgres bootstrap entrypoint.
ENTRYPOINT ["/app/backup_scheduler.sh"]
