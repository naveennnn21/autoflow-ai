# AutoFlow AI - Staging .env for production compose
# Uses non-conflicting ports (existing services on 5432/6379)

# --- Database ---
POSTGRES_USER=autoflow
POSTGRES_PASSWORD=autoflow_staging_secure_2026
POSTGRES_DB=autoflow
POSTGRES_PORT=5434

# --- Redis ---
REDIS_PASSWORD=autoflow_redis_staging_2026
REDIS_PORT=6381

# --- Backend ---
SECRET_KEY=staging-prod-compose-secret-key-very-long-random-string-1234567890abcdef
BACKEND_PORT=8002
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3001","http://localhost:8002"]

# --- Frontend ---
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8002/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- AI Providers (leave empty for deterministic mode) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Monitoring ---
SENTRY_DSN=

# --- Payments ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
