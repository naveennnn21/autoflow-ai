# AutoFlow AI - staging environment TEMPLATE
# ===========================================
# Copy this file to `.env.staging` (which is gitignored) and fill in real
# values. This tracked file holds placeholders ONLY - never commit real
# credentials, keys or tokens.
#
#   cp .env.staging.example .env.staging
#   # edit .env.staging with the staging values
#
# Generate strong secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=autoflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=autoflow
POSTGRES_PORT=5432

# --- Redis -------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# --- Backend -----------------------------------------------------------
# Must not be a default value; Compose refuses to start in production if unset.
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
BACKEND_PORT=8000
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["https://staging.example.com"]

# --- Frontend ----------------------------------------------------------
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://staging.example.com/api/v1
NEXT_PUBLIC_SITE_URL=https://staging.example.com

# --- AI providers (optional) ------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Monitoring / payments (optional) ---------------------------------
SENTRY_DSN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
